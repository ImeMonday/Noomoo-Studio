<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brand.name }} - Instagram kit preview</title>
<style>
:root { --ink: {{ p.ink }}; --paper: {{ p.paper }}; --primary: {{ p.primary }}; --accent: {{ p.accent }}; }
* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: system-ui, sans-serif; }
header { padding: 40px 6vw 8px; }
h1 { margin: 0; font-size: clamp(28px, 4vw, 44px); font-family: '{{ brand.fonts.display.family }}', Georgia, serif; font-weight: 400; }
header p { margin: 6px 0 0; opacity: .7; }
main { display: grid; grid-template-columns: minmax(300px, 460px) 1fr; gap: 48px; padding: 24px 6vw 64px; align-items: start; }
h2 { font-size: 15px; font-weight: 600; margin: 0 0 12px; }
.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; background: var(--ink); padding: 3px; border-radius: 6px; }
.grid .tile { aspect-ratio: 3 / 4; overflow: hidden; background: #000; }
.grid .tile svg { display: block; height: 100%; width: auto; margin: 0 auto; }
.stories { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; }
.stories svg { display: block; width: 100%; height: auto; border-radius: 14px; box-shadow: 0 6px 24px rgba(0,0,0,.18); }
@media (max-width: 860px) { main { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<header><h1>{{ brand.name }}</h1><p>{{ brand.tagline }} - generated by noomoo-studio. All text below is live and selectable.</p></header>
<main>
<section><h2>Instagram grid (3:4 crop, as shown on profiles)</h2>
<div class="grid">{% for s in posts %}<div class="tile">{{ s }}</div>{% endfor %}</div></section>
<section><h2>Stories (9:16)</h2>
<div class="stories">{% for s in stories %}{{ s }}{% endfor %}</div></section>
</main>
</body>
</html>
