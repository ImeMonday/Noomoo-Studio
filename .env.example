# Optional. Leave AI_PROVIDER=none to run fully offline with deterministic, curated copy.
# Copy this file to .env (never commit it) and fill in your own values.
AI_PROVIDER=none

# Any OpenAI-compatible chat-completions base URL, copied from your provider's docs.
# Qwen (Alibaba Cloud Model Studio, international):
#   AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   AI_MODEL=qwen-plus
# Meta Model API (Muse Spark): use the base URL and model name from dev.meta.ai
AI_BASE_URL=
AI_MODEL=qwen-plus
MODEL_API_KEY=
